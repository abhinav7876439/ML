# Compute Whittle Indices from Grid
def compute_whittle_indices_from_grid(Pb_by_w, w_values):
    """
    Compute Whittle index for each state as the smallest subsidy w
    where the state enters the passive set Pb(w)
    """
    whittle = {}
    sorted_w = sorted(w_values)
    for si in range(nS):
        found = False
        for w in sorted_w:
            if si in Pb_by_w[w]:
                whittle[si] = w
                found = True
                break
        if not found:
            whittle[si] = np.inf
    return whittle


