def extract_P0_P1_R0_R1():
    """
    Build numeric transition matrices P0 (passive) and P1 (active),
    and reward vectors R0,R1 (package expects rewards).
    Assumes build_model(w, tau) returns (P, c) where:
      - P[(si,a)] -> dict of {sj: prob}
      - c[(si,a)] -> scalar cost
    """

    P_dict, c_dict = build_base_model(tau=tau)

    # initialize numeric matrices
    P0 = np.zeros((nS, nS), dtype=float)
    P1 = np.zeros((nS, nS), dtype=float)
    c_passive = np.zeros(nS, dtype=float)
    c_active = np.zeros(nS, dtype=float)


    for si in range(nS):
        # passive (action=0)
        trans0 = P_dict.get((si, 0), {})
        for sj, prob in trans0.items():
            P0[si, sj] = prob
        c_passive[si] = c_dict[(si, 0)]

        # active (action=1)
        trans1 = P_dict.get((si, 1), {})
        for sj, prob in trans1.items():
            P1[si, sj] = prob
        c_active[si] = c_dict[(si, 1)]

    # sanity: small numerical fixes for rows that are nearly but not exactly 1
    row_sums0 = P0.sum(axis=1)
    row_sums1 = P1.sum(axis=1)

    # If any row sum deviates by tiny epsilon, normalize to 1.0
    eps = 1e-12
    for i in range(nS):
        if abs(row_sums0[i] - 1.0) > eps and row_sums0[i] > 0:
            P0[i, :] /= row_sums0[i]
        if abs(row_sums1[i] - 1.0) > eps and row_sums1[i] > 0:
            P1[i, :] /= row_sums1[i]

    # Convert costs to rewards expected by package (reward = -cost)
    R0 = -c_passive.copy()
    R1 = -c_active.copy()

    # quick sanity prints
    print("extract_P0_P1_R0_R1: shapes ->", P0.shape, P1.shape, R0.shape, R1.shape)
    print("Row-sum stats: P0 min/max =", row_sums0.min(), "/", row_sums0.max(),
          " P1 min/max =", row_sums1.min(), "/", row_sums1.max())

    return P0, P1, R0, R1


